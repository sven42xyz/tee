{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tee",
  // Custom entrypoint: API routes + Astro handler + Durable Object export
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Static assets (filled by the Astro build)
  "assets": { "binding": "ASSETS" },

  // One Durable Object per room, plus a single Quota object that enforces the storage limits
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "QUOTA", "class_name": "Quota" },
      { "name": "MODERATION", "class_name": "Moderation" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Quota"] },
    { "tag": "v3", "new_sqlite_classes": ["Moderation"] }
  ],

  // Report notifications via Cloudflare Email Routing. Only verified destination addresses
  // can receive mail; the recipient comes from the REPORT_TO secret, not from this file.
  "send_email": [{ "name": "REPORT_MAIL" }],

  // Files. EU jurisdiction: data stays in the EU
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "tee-files", "jurisdiction": "eu" }],

  // Rate limiting per IP (period: 10 or 60 seconds)
  "ratelimits": [
    {
      "name": "RL_CREATE",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "RL_WRITE",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 }
    }
  ],

  // Turnstile (room creation), widget "tee Raumerstellung". Empty = disabled.
  // Secret: `wrangler secret put TURNSTILE_SECRET_KEY`. Locally: .dev.vars (see .dev.vars.example)
  "vars": { "TURNSTILE_SITE_KEY": "0x4AAAAAAFTFRdi6GsGoj81e" },

  // Secrets this Worker expects (values are set with `wrangler secret put`, never here).
  // Declaring them makes `wrangler types` independent of a local .dev.vars, e.g. in CI.
  "secrets": { "required": ["TURNSTILE_SECRET_KEY", "ADMIN_SECRET", "REPORT_TO"] },

  // Custom domain (the DNS record is created automatically on deploy)
  "routes": [{ "pattern": "tee.chapter42.de", "custom_domain": true }],

  // workers.dev URLs for production and previews
  "workers_dev": true,
  "preview_urls": true,

  // Worker Previews (`wrangler preview`): bindings are not inherited and have to be
  // declared again here. Separate bucket and rate limit namespaces, so preview data
  // never mixes with production.
  "previews": {
    "vars": { "TURNSTILE_SITE_KEY": "0x4AAAAAAFTFRdi6GsGoj81e" },
    "secrets": { "required": ["TURNSTILE_SECRET_KEY", "ADMIN_SECRET", "REPORT_TO"] },
    "durable_objects": {
      "bindings": [
        { "name": "ROOM", "class_name": "Room" },
        { "name": "QUOTA", "class_name": "Quota" },
        { "name": "MODERATION", "class_name": "Moderation" }
      ]
    },
    "send_email": [{ "name": "REPORT_MAIL" }],
    "r2_buckets": [{ "binding": "FILES", "bucket_name": "tee-files-preview", "jurisdiction": "eu" }],
    "ratelimits": [
      {
        "name": "RL_CREATE",
        "namespace_id": "2001",
        "simple": { "limit": 10, "period": 60 }
      },
      {
        "name": "RL_WRITE",
        "namespace_id": "2002",
        "simple": { "limit": 30, "period": 60 }
      }
    ]
  }
}
